# =============================================================================
# Copy to .env and fill in. Never commit .env.
#   PowerShell:  Copy-Item .env.example .env
# scripts/setup.ps1 generates the random secrets for you.
# =============================================================================

# --- AI provider (FREE Gemini by default) ------------------------------------
# Get a free API key at https://aistudio.google.com/apikey
AI_PROVIDER=openai_compatible
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_API_KEY=your-gemini-api-key-here
OPENAI_MODEL=gemini-2.5-flash-lite

# --- Alternative: Claude (paid) ----------------------------------------------
# Set AI_PROVIDER=claude to use Anthropic instead of Gemini.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Required secrets --------------------------------------------------------
# Shared secret between n8n and the engine (32+ random chars)
ENGINE_API_TOKEN=change-me-to-a-long-random-string
# Postgres password (used by the postgres, engine and n8n containers)
POSTGRES_PASSWORD=change-me-postgres-password
# n8n credential encryption key (32+ random chars; keep it - losing it breaks n8n credentials)
N8N_ENCRYPTION_KEY=change-me-n8n-encryption-key

# Used in the HTTP User-Agent so site owners can reach you
CONTACT_EMAIL=your-email@example.com

# --- Safety switch -----------------------------------------------------------
# Phase 1 never submits applications. Leave false.
AUTO_APPLY_ENABLED=false

# --- Dashboard ---------------------------------------------------------------
# Base URL used for links in notifications
PUBLIC_BASE_URL=http://localhost:8080
DASHBOARD_PORT=8080
# Optional: protect the dashboard with HTTP Basic auth (user: admin)
DASHBOARD_PASSWORD=

# --- Search engines (RECOMMENDED - for internet-wide job search) -------------
# Tavily: FREE, 1000 searches/month, no credit card.
# Sign up at https://tavily.com/ and paste your key here.
# This is your main tool for searching the ENTIRE INTERNET for jobs.
TAVILY_API_KEY=

# Brave Search API (optional): https://brave.com/search/api/
BRAVE_API_KEY=

# FindWork.dev job API (free key from https://findwork.dev/developers/). Without it that
# one source is skipped; every other source still runs.
FINDWORK_API_KEY=

# Google Programmable Search JSON API (optional)
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# --- Notifications (optional - set Telegram and/or email) --------------------
# Telegram: create a bot with @BotFather, send it a message, then get your chat id
# from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email via SMTP (Gmail: smtp.gmail.com:587 with an App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
NOTIFY_EMAIL_TO=

# --- Misc --------------------------------------------------------------------
LOG_LEVEL=INFO
GENERIC_TIMEZONE=Asia/Kathmandu
