# =============================================================================
# Copy to .env and fill in. Never commit .env.
#   PowerShell:  Copy-Item .env.example .env
# scripts/setup.ps1 generates the random secrets for you.
# =============================================================================

# --- AI provider ---------------------------------------------------------------
# claude = Anthropic API (below). openai_compatible = OmniRoute, OpenRouter, Ollama, LM Studio, ...
AI_PROVIDER=openai_compatible
# Base URL ending in /v1. If the API runs on this PC (not in Docker), use host.docker.internal
# instead of localhost, e.g. http://host.docker.internal:20128/v1
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gemini-2.5-flash-lite

# --- Required ----------------------------------------------------------------
# Claude API key from https://console.anthropic.com/  (analysis will pause without it;
# discovery and rule-based filtering still run)
ANTHROPIC_API_KEY=
# Model for all AI steps. claude-opus-5 (default, best quality), claude-sonnet-5 (cheaper),
# claude-haiku-4-5 (cheapest).
ANTHROPIC_MODEL=claude-haiku-4-5

# Shared secret between n8n and the engine (32+ random chars)
ENGINE_API_TOKEN=change-me-to-a-long-random-string
# Postgres password (used by the postgres, engine and n8n containers)
POSTGRES_PASSWORD=change-me-postgres-password
# n8n credential encryption key (32+ random chars; keep it - losing it breaks n8n credentials)
N8N_ENCRYPTION_KEY=change-me-n8n-encryption-key

# Used in the HTTP User-Agent so site owners can reach you
CONTACT_EMAIL=ujwolstha712@gmail.com

# --- Safety switch -------------------------------------------------------------
# Phase 1 never submits applications. Leave false.
AUTO_APPLY_ENABLED=false

# --- Dashboard -----------------------------------------------------------------
# Base URL used for links in notifications
PUBLIC_BASE_URL=http://localhost:8080
# Host port for the dashboard (change if 8080 is taken; update PUBLIC_BASE_URL too)
DASHBOARD_PORT=8080
# Optional: protect the dashboard with HTTP Basic auth (user: admin)
DASHBOARD_PASSWORD=

# --- Web search providers (optional - each one you set is used) ------------------
# Brave Search API: https://brave.com/search/api/
BRAVE_API_KEY=
# Tavily: https://tavily.com/
TAVILY_API_KEY=
# Google Programmable Search JSON API (only if your project still has access)
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# --- Notifications (optional - set Telegram and/or email) ---------------------
# Telegram: create a bot with @BotFather, send it a message, then get your chat id
# from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email via SMTP (Gmail: smtp.gmail.com:587 with an App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
NOTIFY_EMAIL_TO=

# --- Misc -----------------------------------------------------------------------
LOG_LEVEL=INFO
GENERIC_TIMEZONE=Asia/Kathmandu
